# CampusFlow V3 Backend Environment Template (.env.example)

# Server Configuration
PORT=8000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Note: Use your Supabase project credentials. For database pool connection:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Authentication & JWT Secrets (used for session fallback and identity signing)
ACCESS_TOKEN_SECRET=your_jwt_access_secret_32_characters_minimum
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_32_characters_minimum
REFRESH_TOKEN_EXPIRY=10d

# Administrator Registration Passkey (for TPO Officer signups)
ADMIN_SECRET_KEY=TPO_ADMIN_2026

# Cloudinary CDN Configuration (Optional: for live avatar, company logo, JD PDFs & resume uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email (Resend HTTPS API or SMTP)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
EMAIL_FROM="CampusFlow Notifications <notifications@campusflow.edu>"

# Frontend Application URL (used in email notifications and password resets)
FRONTEND_URL=http://localhost:5173

# AI Services (Groq AI / Gemini API)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key
