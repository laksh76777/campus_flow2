# ==============================================================================
# CampusFlow V3 Root Git Ignore
# Protects against secret key leakage, node_modules, build artifacts & system files
# ==============================================================================

# 1. Environment & Secret Configuration Files (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# 2. Cryptographic Keys, Certificates, and Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*service-account*.json
*credentials*.json
firebase-adminsdk*.json

# 3. Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# 4. Production Build & Distribution Artifacts
dist/
*/dist/
build/
*/build/
out/
*/out/

# 5. Testing & Coverage Outputs
coverage/
*/coverage/
.nyc_output/
*.lcov

# 6. Logs & Process Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. Runtime & Cache Directories
.cache/
.parcel-cache/
.turbo/
.next/
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo

# 8. Temporary Files & Local Scratchpads
tmp/
temp/
scratch/
uploads/
*/uploads/

# 9. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 10. IDE & Editor Workspace Configs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace


# 11. Database Snapshots & Backups
backups/
*/backups/
*.dump
*.sql.gz

.csv